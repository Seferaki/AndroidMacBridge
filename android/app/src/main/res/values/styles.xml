<resources>
    <style name="BridgeTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#1769E8</item>
    </style>

    <style name="ClipboardSendTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#1769E8</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.24</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowMinWidthMajor">62%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
